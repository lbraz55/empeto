// Tema escuro, minimalista e monocromático (seção 1.3 / 6). Alvos de toque >= 48px (RNF-06).

export global Theme {
    in-out property <bool> large: false;
    out property <float> k: large ? 1.2 : 1.0;

    out property <color> bg: #000000;
    out property <color> surface: #111111;
    out property <color> surface2: #1a1a1a;
    out property <color> surface3: #242424;
    out property <color> border: #303030;
    out property <color> border-strong: #5a5a5a;
    out property <color> text: #f5f5f5;
    out property <color> muted: #a3a3a3;
    out property <color> faint: #6b6b6b;
    out property <color> accent: #ffffff;
    out property <color> on-accent: #000000;
    out property <color> pressed: #333333;

    out property <length> fs-xs: 12px * k;
    out property <length> fs-s: 14px * k;
    out property <length> fs-m: 16px * k;
    out property <length> fs-l: 19px * k;
    out property <length> fs-xl: 24px * k;
    out property <length> fs-xxl: 30px * k;
    out property <length> fs-timer: 84px * k;

    out property <length> touch: 48px;
    out property <length> radius: 14px;
    out property <length> pad: 16px;
    out property <length> gap: 10px;
}


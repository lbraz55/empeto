// Paleta escura monocromática (documento EMPETO, seção 6.2).
export global DarkPalette {
    out property <color> background: #111111;
    out property <color> surface: #1B1B1B;
    out property <color> elevated: #292929;
    out property <color> elevated2: #343434;
    out property <color> text-primary: #FFFFFF;
    out property <color> text-secondary: #BDBDBD;
    out property <color> text-faint: #8A8A8A;
    out property <color> border: #444444;
    out property <color> border-strong: #6A6A6A;
}

// Paleta clara monocromática (documento EMPETO, seção 6.2).
export global LightPalette {
    out property <color> background: #FFFFFF;
    out property <color> surface: #F5F5F5;
    out property <color> elevated: #EAEAEA;
    out property <color> elevated2: #DCDCDC;
    out property <color> text-primary: #111111;
    out property <color> text-secondary: #777777;
    out property <color> text-faint: #9A9A9A;
    out property <color> border: #BDBDBD;
    out property <color> border-strong: #8C8C8C;
}

import { ExerciseDetailScreen } from "screens/exercise_detail.slint";
import { OnboardingScreen } from "screens/onboarding.slint";
import { Theme, Icons } from "theme.slint";
import { Bridge } from "bridge.slint";
import { Icon, IconBtn, PageTransition } from "components/widgets.slint";
import { BrandMark, BrandLogoVertical } from "components/brand.slint";
import { Branding } from "themes/branding.slint";
import { HomeScreen, PlansScreen, CalendarScreen, HistoryScreen } from "screens/main.slint";
import { PlanEditorScreen, LibraryScreen, SessionScreen, TimerScreen } from "screens/training.slint";
import { SessionDetailScreen, EvolutionScreen, SettingsScreen, ImportScreen } from "screens/more.slint";
import { FocusScreen } from "screens/focus.slint";
import { SearchScreen } from "screens/search.slint";
import { ConfirmDialog, InfoDialog, ChoiceDialog, TextDialog, DayDialog, PlanExDialog, ExerciseDialog, SubstituteDialog } from "dialogs.slint";

export { Bridge, Theme }

component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    accessible-role: tab;
    accessible-label: text;
    accessible-checked: selected;
    accessible-action-default => { clicked(); }
    TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        Rectangle {
            height: 30px;
            Rectangle {
                width: 56px;
                height: 30px;
                x: (parent.width - self.width) / 2;
                border-radius: 15px;
                background: root.selected ? Theme.surface3 : transparent;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    cmd: root.icon;
                    tint: root.selected ? Theme.text : Theme.muted;
                    size: 22px;
                }
            }
        }
        Text {
            text: root.text;
            color: root.selected ? Theme.text : Theme.muted;
            font-size: Theme.fs-xs;
            font-weight: root.selected ? 700 : 400;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: @tr("EMPETO");
    background: Theme.bg;
    preferred-width: 400px;
    preferred-height: 820px;
    min-width: 320px;
    min-height: 480px;
    default-font-size: Theme.fs-m;

    property <length> kb: self.virtual-keyboard-size.height;
    // Mantém o foco no FocusScope raiz para o botão Voltar do Android funcionar após
    // fechar diálogos ou trocar de tela.
    property <string> dlg: Bridge.dialog;
    property <int> pg: Bridge.page;
    changed dlg => { if (self.dlg == "") { fs.focus(); } }
    changed pg => { fs.focus(); }
    property <bool> main-page: Bridge.page < 10;
    property <string> page-title:
        Bridge.page == 0 ? Branding.name
        : Bridge.page == 1 ? @tr("Treinos")
        : Bridge.page == 2 ? @tr("Calendário")
        : Bridge.page == 3 ? @tr("Histórico")
        : Bridge.page == 10 ? @tr("Editar ficha")
        : Bridge.page == 11 ? (Bridge.lib-mode == "pick" ? @tr("Escolher exercício") : @tr("Exercícios"))
        : Bridge.page == 12 ? Bridge.session-title
        : Bridge.page == 13 ? @tr("Cronômetro")
        : Bridge.page == 16 ? @tr("Modo foco")
        : Bridge.page == 17 ? @tr("Buscar")
        : Bridge.page == 19 ? @tr("Exercício")
        : Bridge.page == 14 ? @tr("Sessão realizada")
        : Bridge.page == 15 ? @tr("Evolução")
        : Bridge.page == 20 ? (
            Bridge.settings-section == 0 ? @tr("Preferências")
            : Bridge.settings-section == 1 ? @tr("Sons e alertas")
            : Bridge.settings-section == 2 ? @tr("Cronômetro")
            : Bridge.settings-section == 3 ? @tr("Treinamento")
            : Bridge.settings-section == 4 ? @tr("Calendário")
            : Bridge.settings-section == 5 ? @tr("Interface")
            : Bridge.settings-section == 6 ? @tr("Dados e armazenamento")
            : Bridge.settings-section == 8 ? @tr("Recursos opcionais")
            : Bridge.settings-section == 9 ? @tr("Atalhos da Home")
            : Bridge.settings-section == 10 ? @tr("Backups")
            : @tr("Sobre"))
        : Bridge.page == 21 ? @tr("Importar planilha")
        : "";

    fs := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Back || e.text == Key.Escape) {
                Bridge.back();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding-top: root.safe-area-insets.top;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;
            padding-bottom: root.kb > 0 ? root.kb : root.safe-area-insets.bottom;

            // Cabeçalho: título + atalho do cronômetro + engrenagem (Configurações) em todas as telas.
            if Bridge.page != 18: Rectangle {
                height: 56px;
                background: Theme.bg;
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    spacing: 2px;
                    if !root.main-page: IconBtn {
                        icon: Icons.back;
                        label: @tr("Voltar");
                        clicked => { Bridge.back(); }
                    }
                    if root.main-page: Rectangle { width: 12px; }
                    if Bridge.page == 0: BrandMark {
                        size: 30px;
                        y: (parent.height - self.height) / 2;
                    }
                    if Bridge.page == 0: Rectangle { width: 6px; }
                    Text {
                        text: root.page-title;
                        color: Theme.text;
                        font-size: Theme.fs-xl;
                        font-weight: 700;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if Bridge.page != 13 && (Bridge.timer-status == "running" || Bridge.timer-status == "paused" || Bridge.timer-status == "finished"): Rectangle {
                        width: chip.preferred-width + 20px;
                        height: 36px;
                        y: 10px;
                        border-radius: 18px;
                        background: Bridge.timer-status == "finished" ? Theme.accent : Theme.surface3;
                        accessible-role: button;
                        accessible-label: @tr("Abrir cronômetro, ") + Bridge.timer-display;
                        accessible-action-default => { Bridge.open-timer(); }
                        TouchArea {
                            clicked => { Bridge.open-timer(); }
                        }
                        chip := HorizontalLayout {
                            x: 10px;
                            spacing: 4px;
                            Icon {
                                y: (parent.height - self.height) / 2;
                                cmd: Icons.timer;
                                size: 18px;
                                tint: Bridge.timer-status == "finished" ? Theme.on-accent : Theme.text;
                            }
                            Text {
                                text: Bridge.timer-display;
                                color: Bridge.timer-status == "finished" ? Theme.on-accent : Theme.text;
                                font-size: Theme.fs-s;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.main-page: IconBtn {
                        icon: Icons.search;
                        label: @tr("Buscar");
                        clicked => { Bridge.open-search(); }
                    }
                    if Bridge.page != 20: IconBtn {
                        icon: Icons.gear;
                        label: @tr("Configurações");
                        clicked => { Bridge.navigate(20); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;
                if Bridge.page == 0: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; HomeScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 1: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; PlansScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 2: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; CalendarScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 3: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; HistoryScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 10: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; PlanEditorScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 11: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; LibraryScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 12: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; SessionScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 13: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; TimerScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 14: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; SessionDetailScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 15: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; EvolutionScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 16: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; FocusScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 17: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; SearchScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 20: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; SettingsScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 19: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; ExerciseDetailScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 18: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; OnboardingScreen { width: parent.width; height: parent.height; } }
                if Bridge.page == 21: PageTransition { width: parent.width; height: parent.height; dir: Bridge.nav-dir; ImportScreen { width: parent.width; height: parent.height; } }
            }

            // Barra inferior: Calendário, Treinos, Home, Histórico (2.3).
            if root.main-page && root.kb == 0: Rectangle {
                height: 64px;
                background: Theme.surface;
                Rectangle {
                    y: 0;
                    height: 1px;
                    background: Theme.border;
                }
                HorizontalLayout {
                    NavItem {
                        icon: Icons.calendar;
                        text: @tr("Calendário");
                        selected: Bridge.page == 2;
                        clicked => { Bridge.navigate(2); }
                    }
                    NavItem {
                        icon: Icons.dumbbell;
                        text: @tr("Treinos");
                        selected: Bridge.page == 1;
                        clicked => { Bridge.navigate(1); }
                    }
                    NavItem {
                        icon: Icons.home;
                        text: @tr("Home");
                        selected: Bridge.page == 0;
                        clicked => { Bridge.navigate(0); }
                    }
                    NavItem {
                        icon: Icons.history;
                        text: @tr("Histórico");
                        selected: Bridge.page == 3;
                        clicked => { Bridge.navigate(3); }
                    }
                }
            }
        }

        // Diálogos (dentro do FocusScope para que o botão Voltar do Android os feche).
        if Bridge.dialog == "confirm": ConfirmDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "info": InfoDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "choice": ChoiceDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "text": TextDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "day": DayDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "plan-ex": PlanExDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "exercise": ExerciseDialog { width: parent.width; height: parent.height; }
        if Bridge.dialog == "substitute": SubstituteDialog { width: parent.width; height: parent.height; }

        if Bridge.toast != "": toast-box := Rectangle {
            property <float> t: 0;
            // Aciona a animação após o primeiro quadro (alterar no init não anima).
    Timer {
        interval: 1ms;
        running: true;
        triggered => {
            self.running = false;
            toast-box.t = 1;
        }
    }
            animate t { duration: Theme.anim-dialog; easing: ease-out; }
            opacity: self.t;
            x: 16px;
            width: parent.width - 32px;
            height: max(48px, toast-text.preferred-height + 24px);
            y: parent.height - self.height - 84px - root.safe-area-insets.bottom - root.kb + (1 - self.t) * 16px;
            border-radius: 12px;
            background: Theme.text;
            TouchArea {
                clicked => { Bridge.toast = ""; }
            }
            HorizontalLayout {
                x: 14px;
                width: parent.width - 20px;
                y: 6px;
                height: parent.height - 12px;
                spacing: 8px;
                toast-text := Text {
                    text: Bridge.toast;
                    color: Theme.on-accent;
                    font-size: Theme.fs-s;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
                if Bridge.toast-action != "": Rectangle {
                    width: act.preferred-width + 24px;
                    border-radius: 10px;
                    background: aa.pressed ? Theme.on-accent.with-alpha(0.2) : transparent;
                    accessible-role: button;
                    accessible-label: Bridge.toast-action;
                    accessible-action-default => { Bridge.toast-action-clicked(); }
                    aa := TouchArea {
                        clicked => { Bridge.toast-action-clicked(); }
                    }
                    act := Text {
                        text: Bridge.toast-action;
                        color: Theme.on-accent;
                        font-size: Theme.fs-m;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Abertura (evolução 3.1): logo centralizado que esmaece logo após o primeiro quadro.
        // Não intercepta toques e não espera nada: respeita a desativação/redução de animações.
        if !Bridge.splash-done: splash := Rectangle {
            property <float> t: 1;
            background: Theme.bg;
            opacity: self.t;
            animate t { duration: Theme.anim-enabled ? 380ms : 0ms; easing: ease-in; }
            BrandLogoVertical {
                x: (parent.width - self.preferred-width) / 2;
                y: (parent.height - self.preferred-height) / 2;
            }
            Timer {
                interval: 120ms;
                running: splash.t > 0;
                triggered => { splash.t = 0; }
            }
            Timer {
                interval: 600ms;
                running: true;
                triggered => { Bridge.splash-done = true; }
            }
        }

        if Bridge.busy: Rectangle {
            background: Theme.scrim.with-alpha(0.6);
            TouchArea { }
            Text {
                text: @tr("Processando…");
                color: Theme.text;
                font-size: Theme.fs-l;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

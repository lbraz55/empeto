import { Theme, Icons } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Btn, Icon, ValueRow, Title, Label, Body, Scroll } from "../components/widgets.slint";
import { BrandLogoVertical } from "../components/brand.slint";

// Boas-vindas (documento de evolução v1.1, 3.2): apresentação, tour, personalização e primeiros passos.
// Pode ser pulada a qualquer momento e refeita em Configurações › Sobre.

component FeatureRow inherits HorizontalLayout {
    in property <string> icon;
    in property <string> title;
    in property <string> text;
    spacing: 14px;
    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: Theme.surface2;
        border-width: 1px;
        border-color: Theme.border;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            cmd: root.icon;
            size: 22px;
        }
    }
    VerticalLayout {
        spacing: 2px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-m;
            font-weight: 700;
            wrap: word-wrap;
        }
        Text {
            text: root.text;
            color: Theme.muted;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }
    }
}

component StepLine inherits HorizontalLayout {
    in property <string> n;
    in property <string> text;
    spacing: 12px;
    Rectangle {
        width: 28px;
        height: 28px;
        border-radius: 14px;
        background: Theme.accent;
        Text {
            text: root.n;
            color: Theme.on-accent;
            font-size: Theme.fs-s;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.fs-m;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

export component OnboardingScreen inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        padding: Theme.pad;
        spacing: 12px;
        // topo: indicador de etapa + pular
        HorizontalLayout {
            height: 44px;
            spacing: 6px;
            for i in 4: Rectangle {
                y: (parent.height - self.height) / 2;
                width: i == Bridge.onboarding-step ? 22px : 8px;
                height: 8px;
                border-radius: 4px;
                background: i <= Bridge.onboarding-step ? Theme.text : Theme.border;
                animate width { duration: Theme.anim-fast; }
            }
            Rectangle { horizontal-stretch: 1; }
            if Bridge.onboarding-step < 3: Btn {
                horizontal-stretch: 0;
                compact: true;
                kind: "ghost";
                text: @tr("Pular");
                clicked => { Bridge.onboarding-skip(); }
            }
        }
        Scroll {
            vertical-stretch: 1;
            if Bridge.onboarding-step == 0: VerticalLayout {
                spacing: 18px;
                Rectangle { height: 24px; }
                BrandLogoVertical { }
                Text {
                    text: @tr("Seu organizador pessoal de treinos.");
                    color: Theme.text;
                    font-size: Theme.fs-xl;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: @tr("Planeje suas fichas, registre cada série e acompanhe sua evolução. Tudo fica no seu aparelho: sem conta, sem anúncios e funcionando sem internet.");
                    color: Theme.muted;
                    font-size: Theme.fs-m;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            if Bridge.onboarding-step == 1: VerticalLayout {
                spacing: 18px;
                Title { text: @tr("O que você pode fazer"); }
                FeatureRow {
                    icon: Icons.dumbbell;
                    title: @tr("Fichas");
                    text: @tr("Monte treinos por dia da semana ou em sequência (A, B, C…), ou comece por um modelo pronto.");
                }
                FeatureRow {
                    icon: Icons.play;
                    title: @tr("Sessões");
                    text: @tr("Registre a carga e as repetições reais de cada série, com modo foco e teclado numérico.");
                }
                FeatureRow {
                    icon: Icons.timer;
                    title: @tr("Cronômetro");
                    text: @tr("Controle o descanso com alertas, mesmo com a tela bloqueada.");
                }
                FeatureRow {
                    icon: Icons.chart;
                    title: @tr("Histórico e evolução");
                    text: @tr("Calendário, recordes pessoais e gráficos mostram seu progresso.");
                }
                FeatureRow {
                    icon: Icons.copy;
                    title: @tr("Backups");
                    text: @tr("Backup automático semanal no aparelho. Salve uma cópia fora dele para não perder nada.");
                }
            }
            if Bridge.onboarding-step == 2: VerticalLayout {
                spacing: 4px;
                Title { text: @tr("Deixe do seu jeito"); }
                Label { text: @tr("Você pode mudar tudo isso depois em Configurações."); }
                Rectangle { height: 8px; }
                ValueRow {
                    text: @tr("Idioma");
                    value: Bridge.set-language;
                    clicked => { Bridge.pref-choose("language"); }
                }
                ValueRow {
                    text: @tr("Tema");
                    value: Bridge.set-theme;
                    clicked => { Bridge.pref-choose("theme"); }
                }
                ValueRow {
                    text: @tr("Tamanho do texto");
                    value: Bridge.set-text-size;
                    clicked => { Bridge.pref-choose("text-size"); }
                }
                ValueRow {
                    text: @tr("Animações");
                    value: Bridge.set-anim;
                    clicked => { Bridge.pref-choose("anim"); }
                }
            }
            if Bridge.onboarding-step == 3: VerticalLayout {
                spacing: 16px;
                Title { text: @tr("Primeiros passos"); }
                StepLine { n: "1"; text: @tr("Crie uma ficha em Treinos — ou escolha um modelo."); }
                StepLine { n: "2"; text: @tr("No dia do treino, toque em Iniciar."); }
                StepLine { n: "3"; text: @tr("Registre cada série e use o cronômetro no descanso."); }
                StepLine { n: "4"; text: @tr("Finalize a sessão para guardá-la no histórico."); }
                Rectangle { height: 8px; }
                Btn {
                    text: @tr("Criar minha primeira ficha");
                    icon: Icons.plus;
                    kind: "primary";
                    clicked => { Bridge.onboarding-finish("create"); }
                }
                Btn {
                    text: @tr("Conhecer o aplicativo primeiro");
                    clicked => { Bridge.onboarding-finish("explore"); }
                }
            }
        }
        // rodapé: voltar / avançar
        if Bridge.onboarding-step < 3: HorizontalLayout {
            spacing: 10px;
            if Bridge.onboarding-step > 0: Btn {
                text: @tr("Voltar");
                clicked => { Bridge.onboarding-step -= 1; }
            }
            Btn {
                text: Bridge.onboarding-step == 0 ? @tr("Começar") : @tr("Avançar");
                kind: "primary";
                clicked => { Bridge.onboarding-step += 1; }
            }
        }
        if Bridge.onboarding-step == 3: HorizontalLayout {
            Btn {
                text: @tr("Voltar");
                clicked => { Bridge.onboarding-step -= 1; }
            }
        }
    }
}

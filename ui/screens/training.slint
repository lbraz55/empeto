import { ExerciseArt } from "../components/exercise_art.slint";
import { Theme, Icons } from "../theme.slint";
import { Bridge, SetRow, SessionExRow } from "../bridge.slint";
import { RestTimerIndicator } from "../components/rest_timer_indicator.slint";
import { SessionProgress } from "../components/session_progress.slint";
import { StarBtn, DragHandle } from "../components/widgets.slint";
import { Btn, IconBtn, Card, Label, Title, SectionTitle, Body, Scroll, Segmented, Badge, Field, ToggleRow, Chip, Icon, Divider } from "../components/widgets.slint";
import { EmptyState } from "../components/empty_state.slint";

// RF-01..RF-03: edição da ficha (dias/sequência, exercícios, séries, repetições, carga-alvo).
export component PlanEditorScreen inherits Scroll {
    Field {
        label: @tr("Nome da ficha");
        placeholder: @tr("Ex.: Hipertrofia ABC");
        text <=> Bridge.edit-plan-name;
    }
    Field {
        label: @tr("Objetivo da ficha (opcional)");
        placeholder: @tr("Objetivo, período, observações");
        text <=> Bridge.edit-plan-desc;
    }
    Btn {
        text: @tr("Salvar nome e descrição");
        icon: Icons.check;
        clicked => { Bridge.save-plan-header(Bridge.edit-plan-name, Bridge.edit-plan-desc); }
    }
    SectionTitle { text: @tr("ORGANIZAÇÃO"); }
    Segmented {
        items: [@tr("Dias da semana"), @tr("Sequência A/B/C")];
        selected: Bridge.edit-plan-weekday ? 0 : 1;
        select(i) => { Bridge.set-plan-schedule(i == 0); }
    }
    Label {
        text: Bridge.edit-plan-weekday
            ? @tr("Cada dia da ficha é associado a dias da semana; aparece no calendário nessas datas.")
            : @tr("Os dias seguem em fila (A → B → C → A…). A Home mostra o próximo da sequência.");
    }
    ToggleRow {
        text: @tr("Ficha ativa");
        description: @tr("Fichas ativas aparecem na Home e no calendário.");
        checked: Bridge.edit-plan-active;
        toggled => { Bridge.toggle-plan-active(Bridge.edit-plan-id); }
    }
    SectionTitle { text: @tr("DIAS DE TREINO"); }
    if Bridge.edit-days.length == 0: Label { text: @tr("Adicione o primeiro dia (ex.: Treino A, Peito e tríceps)."); }
    for d in Bridge.edit-days: Card {
        HorizontalLayout {
            spacing: 0px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Title { text: d.name; }
                if d.subtitle != "": Label { text: d.subtitle; }
            }
            DragHandle {
                step: 140px;
                dropped(dd) => { Bridge.drag-day(d.id, dd); }
            }
            IconBtn {
                icon: Icons.up;
                label: @tr("Mover dia para cima");
                clicked => { Bridge.move-day(d.id, -1); }
            }
            IconBtn {
                icon: Icons.down;
                label: @tr("Mover dia para baixo");
                clicked => { Bridge.move-day(d.id, 1); }
            }
            IconBtn {
                icon: Icons.edit;
                label: @tr("Editar dia ") + d.name;
                clicked => { Bridge.edit-day(d.id); }
            }
            IconBtn {
                icon: Icons.trash;
                label: @tr("Excluir dia ") + d.name;
                clicked => { Bridge.delete-day(d.id); }
            }
        }
        if d.exercises.length == 0: Label { text: @tr("Nenhum exercício neste dia."); }
        for e[i] in d.exercises: Rectangle {
            min-height: Theme.touch + 8px;
            background: ta.pressed ? Theme.surface3 : transparent;
            border-width: 0px;
            border-radius: 10px;
            accessible-role: button;
            accessible-label: @tr("Editar ") + e.name;
            accessible-action-default => { Bridge.edit-plan-ex(e.id); }
            ta := TouchArea {
                clicked => { Bridge.edit-plan-ex(e.id); }
            }
            // Barra lateral que une os exercícios de um mesmo grupo (supersérie/trissérie/circuito).
            if e.group-pos > 0: Rectangle {
                x: 0;
                y: e.group-pos == 1 ? parent.height * 0.25 : 0;
                width: 3px;
                height: e.group-pos == 2 ? parent.height : e.group-pos == 1 || e.group-pos == 3 ? parent.height * 0.75 : parent.height;
                background: Theme.text;
            }
            HorizontalLayout {
                padding-left: 4px;
                spacing: 0px;
                ex-handle := DragHandle {
                    step: 60px;
                    dropped(dd) => { Bridge.drag-plan-ex(e.id, dd); }
                }
                Text {
                    width: 24px;
                    text: ex-handle.delta == 0 ? (i + 1) + "." : "→" + Math.max(1, Math.min(d.exercises.length, i + 1 + ex-handle.delta));
                    color: Theme.faint;
                    font-size: Theme.fs-s;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    if e.group-label != "": Text {
                        text: e.group-label;
                        color: Theme.text;
                        font-size: Theme.fs-xs;
                        font-weight: 800;
                    }
                    Body { text: e.name; }
                    Label { text: e.detail; }
                    // Tipo de cada série (toque para alternar): normal, aquecimento, drop, falha, back-off, técnica.
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        for k[j] in e.kinds: Rectangle {
                            height: 26px;
                            min-width: 30px;
                            border-radius: 13px;
                            background: kta.pressed ? Theme.pressed : Theme.surface2;
                            border-width: 1px;
                            border-color: Theme.border;
                            accessible-role: button;
                            accessible-label: @tr("Série ") + (j + 1) + ": " + k;
                            accessible-action-default => { Bridge.pe-cycle-kind(e.id, j + 1); }
                            kta := TouchArea { clicked => { Bridge.pe-cycle-kind(e.id, j + 1); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                Text {
                                    text: k;
                                    color: Theme.text;
                                    font-size: Theme.fs-xs;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                        // Agrupar com o próximo (supersérie/trissérie/circuito).
                        if !e.last: Rectangle {
                            height: 26px;
                            width: 34px;
                            border-radius: 13px;
                            background: e.linked ? Theme.accent : (lta.pressed ? Theme.pressed : Theme.surface2);
                            border-width: 1px;
                            border-color: e.linked ? Theme.accent : Theme.border;
                            accessible-role: button;
                            accessible-checked: e.linked;
                            accessible-label: e.linked ? @tr("Desagrupar do próximo exercício") : @tr("Agrupar com o próximo exercício (supersérie)");
                            accessible-action-default => { Bridge.pe-toggle-group(e.id); }
                            lta := TouchArea { clicked => { Bridge.pe-toggle-group(e.id); } }
                            Icon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                cmd: Icons.link;
                                size: 16px;
                                stroke: 1.8px;
                                tint: e.linked ? Theme.on-accent : Theme.text;
                            }
                        }
                    }
                    if e.notes != "": Label {
                        text: @tr("Obs.: ") + e.notes;
                        color: Theme.faint;
                    }
                    if e.suggestion != "": Rectangle {
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        background: Theme.surface2;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            Text {
                                text: "↑ " + e.suggestion;
                                color: Theme.text;
                                font-size: Theme.fs-s;
                                font-weight: 700;
                                wrap: word-wrap;
                            }
                            Text {
                                text: e.suggestion-detail + @tr(" É só uma sugestão, não uma prescrição.");
                                color: Theme.muted;
                                font-size: Theme.fs-xs;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Btn {
                                    text: @tr("Aceitar");
                                    compact: true;
                                    kind: "primary";
                                    clicked => { Bridge.progression-accept(e.id); }
                                }
                                Btn {
                                    text: @tr("Ignorar");
                                    compact: true;
                                    clicked => { Bridge.progression-dismiss(e.id); }
                                }
                            }
                        }
                    }
                }
                IconBtn {
                    icon: Icons.up;
                    label: @tr("Mover exercício para cima");
                    clicked => { Bridge.move-plan-ex(e.id, -1); }
                }
                IconBtn {
                    icon: Icons.down;
                    label: @tr("Mover exercício para baixo");
                    clicked => { Bridge.move-plan-ex(e.id, 1); }
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Btn {
                text: @tr("Exercício");
                icon: Icons.plus;
                clicked => { Bridge.add-plan-ex(d.id); }
            }
            Btn {
                text: @tr("Iniciar");
                icon: Icons.play;
                kind: "primary";
                enabled: d.exercises.length > 0;
                clicked => { Bridge.start-day(d.id); }
            }
        }
    }
    Btn {
        text: @tr("Adicionar dia");
        icon: Icons.plus;
        clicked => { Bridge.add-day(); }
    }
}

// RF-09: biblioteca pesquisável por grupo muscular, equipamento e padrão de movimento.
// Biblioteca aprimorada (4.1–4.3): busca, filtros em área expansível, favoritos, personalizados.
export component LibraryScreen inherits Scroll {
    if Bridge.lib-mode == "pick": Label { text: @tr("Toque em um exercício para selecioná-lo."); }
    Field {
        placeholder: @tr("Buscar por nome, músculo, equipamento, técnica…");
        input-type: InputType.text;
        text <=> Bridge.lib-search;
        edited(t) => { Bridge.lib-search-changed(t); }
    }
    HorizontalLayout {
        spacing: 8px;
        Btn {
            text: Bridge.lib-active-filters > 0 ? @tr("Filtros (") + Bridge.lib-active-filters + ")" : @tr("Filtros");
            icon: Icons.filter;
            kind: Bridge.lib-filters-open ? "primary" : "secondary";
            accessible-label: (Bridge.lib-filters-open ? @tr("Ocultar filtros") : @tr("Mostrar filtros")) + ", " + Bridge.lib-active-filters + @tr(" ativo(s)");
            clicked => { Bridge.lib-toggle("open"); }
        }
        Btn {
            text: @tr("Novo");
            icon: Icons.plus;
            clicked => { Bridge.lib-new(); }
        }
    }
    if Bridge.lib-filters-open: Card {
        HorizontalLayout {
            spacing: 6px;
            Chip {
                horizontal-stretch: 1;
                text: Bridge.lib-muscle == "" ? @tr("Músculo") : Bridge.lib-muscle;
                selected: Bridge.lib-muscle != "";
                clicked => { Bridge.lib-filter("muscle"); }
            }
            Chip {
                horizontal-stretch: 1;
                text: Bridge.lib-equipment == "" ? @tr("Equipamento") : Bridge.lib-equipment;
                selected: Bridge.lib-equipment != "";
                clicked => { Bridge.lib-filter("equipment"); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Chip {
                horizontal-stretch: 1;
                text: Bridge.lib-type == "" ? @tr("Tipo") : Bridge.lib-type;
                selected: Bridge.lib-type != "";
                clicked => { Bridge.lib-filter("type"); }
            }
            Chip {
                horizontal-stretch: 1;
                text: Bridge.lib-pattern == "" ? @tr("Movimento") : Bridge.lib-pattern;
                selected: Bridge.lib-pattern != "";
                clicked => { Bridge.lib-filter("pattern"); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Chip {
                horizontal-stretch: 1;
                text: (Bridge.lib-favorites ? "★ " : "☆ ") + @tr("Favoritos");
                selected: Bridge.lib-favorites;
                clicked => { Bridge.lib-toggle("favorites"); }
            }
            Chip {
                horizontal-stretch: 1;
                text: @tr("Personalizados");
                selected: Bridge.lib-custom;
                clicked => { Bridge.lib-toggle("custom"); }
            }
            if Bridge.lib-mode == "browse": Chip {
                horizontal-stretch: 1;
                text: @tr("Arquivados");
                selected: Bridge.lib-show-archived;
                clicked => { Bridge.lib-toggle-archived(); }
            }
        }
        if Bridge.lib-active-filters > 0 || Bridge.lib-search != "": Btn {
            text: @tr("Limpar filtros");
            icon: Icons.close;
            compact: true;
            clicked => { Bridge.lib-clear-filters(); }
        }
    }
    Label { text: Bridge.lib-count; }
    if Bridge.library.length == 0: EmptyState {
        icon: Bridge.lib-favorites ? Icons.star : Icons.search;
        title: Bridge.lib-favorites ? @tr("Adicione exercícios aos favoritos") : @tr("Nenhum exercício encontrado");
        text: Bridge.lib-favorites
            ? @tr("Toque na estrela de um exercício para acessá-lo rapidamente aqui.")
            : @tr("Nenhum exercício corresponde à busca e aos filtros. Ajuste os filtros ou crie um exercício personalizado.");
        action: Bridge.lib-favorites ? @tr("Ver todos") : @tr("Limpar filtros");
        action-clicked => { Bridge.lib-clear-filters(); }
    }
    for e in Bridge.library: Card {
        clickable: true;
        accessible-role: button;
        accessible-label: e.name + (e.favorite ? @tr(", favorito") : "") + (e.custom ? @tr(", personalizado") : "") + (e.archived ? @tr(", arquivado") : "");
        clicked => { Bridge.lib-item(e.id); }
        HorizontalLayout {
            spacing: 10px;
            ExerciseArt {
                art: e.art;
                size: 46px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Body {
                    text: e.name;
                    font-weight: 600;
                }
                Label { text: e.detail; }
                if e.archived || e.custom: HorizontalLayout {
                    alignment: start;
                    spacing: 4px;
                    if e.custom: Badge { text: @tr("Personalizado"); }
                    if e.archived: Badge { text: @tr("Arquivado"); }
                }
            }
            StarBtn {
                on: e.favorite;
                name: e.name;
                clicked => { Bridge.lib-favorite(e.id); }
            }
            if Bridge.lib-mode == "browse": IconBtn {
                icon: Icons.edit;
                label: @tr("Editar ") + e.name;
                clicked => { Bridge.lib-edit(e.id); }
            }
        }
    }
    if Bridge.lib-has-more: Btn {
        text: @tr("Carregar mais");
        clicked => { Bridge.lib-more(); }
    }
}

component SetLine inherits Rectangle {
    in property <SetRow> s;
    in property <string> unit;
    in property <int> se-id;
    property <string> load: s.load;
    property <string> reps: s.reps;
    min-height: 92px;
    border-radius: 12px;
    background: s.done ? Theme.surface2 : Theme.surface;
    border-width: 1px;
    border-color: s.done ? Theme.border-strong : Theme.border;
    // Confirmação visual da série concluída (evolução 3.3).
    animate background, border-color { duration: Theme.anim-page; easing: ease-out; }
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                // Toque no rótulo alterna o tipo da série (evolução 8.1).
                accessible-role: button;
                accessible-label: @tr("Série ") + root.s.number + (root.s.kind != "" ? ", " + root.s.kind : "") + @tr(". Toque para mudar o tipo.");
                accessible-action-default => { Bridge.session-cycle-kind(root.s.id); }
                min-width: lbl.preferred-width;
                TouchArea { clicked => { Bridge.session-cycle-kind(root.s.id); } }
                lbl := HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: @tr("Série ") + root.s.number;
                        color: Theme.text;
                        font-size: Theme.fs-m;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    if root.s.kind != "": Badge { text: root.s.kind; }
                }
            }
            Text {
                text: root.s.planned;
                color: Theme.muted;
                font-size: Theme.fs-s;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.s.done: HorizontalLayout {
            spacing: 8px;
            Icon {
                y: (parent.height - self.height) / 2;
                cmd: Icons.check;
                size: 22px;
            }
            Text {
                text: root.s.load + " " + root.unit + @tr("  ×  ") + root.s.reps + @tr(" reps");
                color: Theme.text;
                font-size: Theme.fs-l;
                font-weight: 600;
                vertical-alignment: center;
            }
            Btn {
                text: @tr("Desfazer");
                compact: true;
                horizontal-stretch: 0;
                clicked => { Bridge.session-undo(root.s.id); }
            }
        }
        if !root.s.done: HorizontalLayout {
            spacing: 6px;
            IconBtn {
                width: 40px;
                icon: Icons.minus;
                label: @tr("Diminuir carga");
                clicked => { root.load = Bridge.adjust-load(root.load, -1); }
            }
            Field {
                horizontal-stretch: 2;
                text <=> root.load;
                placeholder: root.unit;
                input-type: InputType.decimal;
                align: center;
                font-size: Theme.fs-l;
            }
            IconBtn {
                width: 40px;
                icon: Icons.plus;
                label: @tr("Aumentar carga");
                clicked => { root.load = Bridge.adjust-load(root.load, 1); }
            }
            Text {
                text: @tr("×");
                color: Theme.muted;
                vertical-alignment: center;
            }
            Field {
                horizontal-stretch: 1;
                text <=> root.reps;
                placeholder: @tr("reps");
                input-type: InputType.number;
                align: center;
                font-size: Theme.fs-l;
            }
            Btn {
                horizontal-stretch: 0;
                icon: Icons.check;
                kind: "primary";
                accessible-label: @tr("Registrar série ") + root.s.number;
                clicked => { Bridge.session-record(root.s.id, root.load, root.reps); }
            }
        }
        if !root.s.done: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Btn {
                text: @tr("Repetir anterior");
                icon: Icons.repeat;
                compact: true;
                horizontal-stretch: 0;
                font-size: Theme.fs-s;
                clicked => {
                    root.load = Bridge.fill-load(root.s.id, "previous");
                    root.reps = Bridge.fill-reps(root.s.id, "previous");
                }
            }
            Btn {
                text: @tr("Planejado");
                compact: true;
                horizontal-stretch: 0;
                font-size: Theme.fs-s;
                clicked => {
                    root.load = Bridge.fill-load(root.s.id, "planned");
                    root.reps = Bridge.fill-reps(root.s.id, "planned");
                }
            }
        }
        if root.s.hint != "": Text {
            text: root.s.hint;
            color: Theme.faint;
            font-size: Theme.fs-xs;
        }
        // Percepção de esforço (8.4): opcional, ativada em Configurações › Treinamento.
        if Bridge.effort-enabled: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Rectangle {
                height: 30px;
                min-width: rpe-t.preferred-width + 20px;
                border-radius: 15px;
                background: rpe-ta.pressed ? Theme.pressed : Theme.surface2;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: "RPE " + (root.s.rpe != "" ? root.s.rpe : "—");
                accessible-action-default => { Bridge.session-effort(root.s.id, "rpe"); }
                rpe-ta := TouchArea { clicked => { Bridge.session-effort(root.s.id, "rpe"); } }
                rpe-t := Text {
                    text: "RPE " + (root.s.rpe != "" ? root.s.rpe : "—");
                    color: Theme.text;
                    font-size: Theme.fs-s;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 30px;
                min-width: rir-t.preferred-width + 20px;
                border-radius: 15px;
                background: rir-ta.pressed ? Theme.pressed : Theme.surface2;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: "RIR " + (root.s.rir != "" ? root.s.rir : "—");
                accessible-action-default => { Bridge.session-effort(root.s.id, "rir"); }
                rir-ta := TouchArea { clicked => { Bridge.session-effort(root.s.id, "rir"); } }
                rir-t := Text {
                    text: "RIR " + (root.s.rir != "" ? root.s.rir : "—");
                    color: Theme.text;
                    font-size: Theme.fs-s;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// RF-04..RF-08, 6.3: exercício centralizado; dados operacionais fáceis de localizar.
export component SessionScreen inherits Rectangle {
    property <SessionExRow> cur: Bridge.session-exercises[Bridge.session-index];
    property <int> count: Bridge.session-exercises.length;
    VerticalLayout {
        Rectangle {
            height: 48px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                Text {
                    text: Bridge.session-progress;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    vertical-alignment: center;
                }
                Text {
                    text: "⏱ " + Bridge.session-elapsed;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Btn {
                    text: @tr("Foco");
                    icon: Icons.focus;
                    compact: true;
                    horizontal-stretch: 0;
                    accessible-label: @tr("Abrir modo foco");
                    clicked => { Bridge.session-focus(); }
                }
            }
        }
        Rectangle {
            height: 38px;
            background: Theme.surface;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                SessionProgress {
                    exercises: Bridge.session-exercises;
                    current: Bridge.session-index;
                    select(i) => { Bridge.session-select(i); }
                }
            }
        }
        Scroll {
            vertical-stretch: 1;
            VerticalLayout {
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 6px;
                Text {
                    text: @tr("Exercício ") + (Bridge.session-index + 1) + @tr(" de ") + root.count;
                    color: Theme.muted;
                    font-size: Theme.fs-s;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    ExerciseArt {
                        art: root.cur.art;
                        size: 72px;
                    }
                }
                Text {
                    text: root.cur.name;
                    color: Theme.text;
                    font-size: Theme.fs-xxl;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.cur.muscle + (root.cur.kind != "" ? "  ·  " + root.cur.kind : "") + (root.cur.equipment != "" ? "  ·  " + root.cur.equipment : "");
                    color: Theme.muted;
                    font-size: Theme.fs-m;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.cur.substitution != "": HorizontalLayout {
                    alignment: center;
                    Badge { text: root.cur.substitution; }
                }
                if root.cur.group != "": HorizontalLayout {
                    alignment: center;
                    Badge { text: root.cur.group; }
                }
                Text {
                    text: root.cur.planned;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
            for st in root.cur.sets: SetLine {
                s: st;
                unit: Bridge.session-unit;
                se-id: root.cur.id;
            }
            HorizontalLayout {
                alignment: start;
                Btn {
                    text: @tr("Anilhas e aquecimento");
                    icon: Icons.tools;
                    compact: true;
                    kind: "ghost";
                    clicked => { Bridge.open-tools(root.cur.id); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    text: @tr("Série");
                    icon: Icons.plus;
                    compact: true;
                    clicked => { Bridge.session-add-set(root.cur.id); }
                }
                Btn {
                    text: @tr("Série");
                    icon: Icons.minus;
                    compact: true;
                    clicked => { Bridge.session-remove-set(root.cur.id); }
                }
                Btn {
                    text: @tr("Obs.");
                    icon: Icons.note;
                    compact: true;
                    clicked => { Bridge.session-ex-notes(root.cur.id); }
                }
            }
            Btn {
                text: @tr("Substituir exercício");
                icon: Icons.swap;
                clicked => { Bridge.session-substitute(root.cur.id); }
            }
            if root.cur.notes != "": Label { text: @tr("Obs.: ") + root.cur.notes; }
            // Valores da sessão anterior (evolução 8.3): só exibidos; repetir é uma ação explícita.
            if root.cur.prev-title != "": Card {
                Text {
                    text: root.cur.prev-title;
                    color: Theme.muted;
                    font-size: Theme.fs-xs;
                    font-weight: 700;
                }
                for l in root.cur.prev-lines: Body { text: l; }
                Btn {
                    text: @tr("Repetir valores da sessão anterior");
                    icon: Icons.repeat;
                    compact: true;
                    clicked => { Bridge.session-repeat-previous(root.cur.id); }
                }
            }
            if root.cur.technique != "": Card {
                Text {
                    text: @tr("TÉCNICA E OBSERVAÇÕES");
                    color: Theme.muted;
                    font-size: Theme.fs-xs;
                    font-weight: 700;
                }
                Body { text: root.cur.technique; }
            }
            Divider { }
            Btn {
                text: @tr("Como foi o treino?") + (Bridge.session-feeling != "" ? " " + Bridge.session-feeling : "");
                icon: Icons.note;
                kind: "ghost";
                clicked => { Bridge.session-choose-feeling(); }
            }
            Btn {
                text: @tr("Observações da sessão");
                icon: Icons.note;
                kind: "ghost";
                clicked => { Bridge.session-edit-notes(); }
            }
            if Bridge.session-notes != "": Label { text: Bridge.session-notes; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    text: @tr("Descartar");
                    kind: "danger";
                    clicked => { Bridge.session-discard(); }
                }
                Btn {
                    text: @tr("Finalizar sessão");
                    icon: Icons.check;
                    kind: "primary";
                    clicked => { Bridge.session-finish(); }
                }
            }
        }
        Rectangle {
            height: 64px;
            background: Theme.surface;
            HorizontalLayout {
                padding: 8px;
                spacing: 8px;
                Btn {
                    icon: Icons.back;
                    horizontal-stretch: 0;
                    min-width: 72px;
                    accessible-label: @tr("Exercício anterior");
                    enabled: Bridge.session-index > 0;
                    clicked => { Bridge.session-select(Bridge.session-index - 1); }
                }
                if Bridge.timer-status == "idle": Btn {
                    icon: Icons.timer;
                    text: @tr("Cronômetro");
                    clicked => { Bridge.open-timer(); }
                }
                if Bridge.timer-status != "idle": RestTimerIndicator {
                    compact: true;
                    horizontal-stretch: 1;
                    display: Bridge.timer-display;
                    status: Bridge.timer-status;
                    ring: Bridge.timer-ring;
                    context: Bridge.timer-context;
                    clicked => { Bridge.open-timer(); }
                }
                Btn {
                    icon: Icons.forward;
                    horizontal-stretch: 0;
                    min-width: 72px;
                    accessible-label: @tr("Próximo exercício");
                    enabled: Bridge.session-index < root.count - 1;
                    clicked => { Bridge.session-select(Bridge.session-index + 1); }
                }
            }
        }
    }
}

// RF-10..RF-12, 6.4: tela própria do cronômetro.
export component TimerScreen inherits Scroll {
    gap: 14px;
    Rectangle { height: 8px; }
    Text {
        text: Bridge.timer-phase;
        color: Theme.muted;
        font-size: Theme.fs-m;
        horizontal-alignment: center;
    }
    if Bridge.timer-context != "": Text {
        text: Bridge.timer-context;
        color: Theme.text;
        font-size: Theme.fs-m;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: Bridge.timer-display;
        color: Bridge.timer-status == "paused" ? Theme.muted : Theme.text;
        font-size: Theme.fs-timer;
        font-weight: 300;
        horizontal-alignment: center;
        accessible-role: text;
        accessible-label: @tr("Tempo restante ") + Bridge.timer-display;
    }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.surface3;
        Rectangle {
            x: 0;
            width: parent.width * Bridge.timer-progress;
            height: parent.height;
            border-radius: 4px;
            background: Theme.accent;
        }
    }
    Text {
        text: Bridge.timer-status == "running" ? @tr("Em contagem")
            : Bridge.timer-status == "paused" ? @tr("Pausado")
            : Bridge.timer-status == "finished" ? @tr("Tempo encerrado — a série só é registrada por você.")
            : @tr("Pronto para iniciar");
        color: Theme.muted;
        font-size: Theme.fs-s;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 10px;
        Btn {
            text: "−" + Bridge.timer-step;
            clicked => { Bridge.timer-adjust(-1); }
        }
        Btn {
            text: "+" + Bridge.timer-step;
            clicked => { Bridge.timer-adjust(1); }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Btn {
            min-height: 60px;
            text: Bridge.timer-status == "running" ? @tr("Pausar") : Bridge.timer-status == "paused" ? @tr("Retomar") : @tr("Iniciar");
            icon: Bridge.timer-status == "running" ? Icons.pause : Icons.play;
            kind: "primary";
            font-size: Theme.fs-l;
            clicked => {
                if (Bridge.timer-status == "running") {
                    Bridge.timer-pause();
                } else {
                    Bridge.timer-start();
                }
            }
        }
        Btn {
            min-height: 60px;
            text: @tr("Reiniciar");
            icon: Icons.reset;
            font-size: Theme.fs-l;
            clicked => { Bridge.timer-reset(); }
        }
    }
    SectionTitle { text: @tr("DURAÇÃO"); }
    HorizontalLayout {
        spacing: 6px;
        for p in Bridge.timer-presets: Chip {
            horizontal-stretch: 1;
            text: p >= 60 && Math.mod(p, 60) == 0 ? (p / 60) + @tr(" min") : p + @tr(" s");
            clicked => { Bridge.timer-preset(p); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Label {
            text: @tr("Duração atual: ") + Bridge.timer-duration;
            vertical-alignment: center;
        }
        Btn {
            text: @tr("Outra…");
            compact: true;
            horizontal-stretch: 0;
            clicked => { Bridge.timer-custom(); }
        }
    }
    if Bridge.timer-notice != "": Label { text: Bridge.timer-notice; }
}

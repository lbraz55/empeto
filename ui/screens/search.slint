import { Theme, Icons } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Card, Label, Body, Badge, Field, Scroll } from "../components/widgets.slint";
import { EmptyState } from "../components/empty_state.slint";

// Busca global (8.2): exercícios, fichas e sessões; os resultados mostram o tipo e abrem a tela.
export component SearchScreen inherits Scroll {
    Field {
        placeholder: "Buscar exercícios, fichas e sessões…";
        text <=> Bridge.search-query;
        edited(t) => { Bridge.search-changed(t); }
    }
    if Bridge.search-query == "": EmptyState {
        icon: Icons.search;
        title: "Busca";
        text: "Digite pelo menos 2 letras. A busca ignora acentos e procura em nomes, objetivos, técnicas e observações.";
    }
    if Bridge.search-query != "" && Bridge.search-results.length == 0: EmptyState {
        icon: Icons.search;
        title: "Nada encontrado";
        text: "Nenhum exercício, ficha ou sessão corresponde à busca.";
    }
    for r[i] in Bridge.search-results: Card {
        clickable: true;
        accessible-role: button;
        accessible-label: r.kind + ": " + r.title + ". " + r.subtitle;
        clicked => { Bridge.search-open(i); }
        HorizontalLayout {
            alignment: start;
            Badge { text: r.kind; }
        }
        Body {
            text: r.title;
            font-weight: 600;
        }
        if r.subtitle != "": Label { text: r.subtitle; }
    }
}

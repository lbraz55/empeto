import { Theme, Icons } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { Btn, IconBtn, Card, Label, Title, SectionTitle, Body, Scroll, Segmented, Badge, ToggleRow, ValueRow, StepperRow, Divider, Icon } from "../components/widgets.slint";
import { EmptyState } from "../components/empty_state.slint";
import { BrandLogoVertical } from "../components/brand.slint";

// 6.6: detalhe da sessão (data, treino, exercícios, cargas, séries, repetições, descansos,
// substituições e observações).
export component SessionDetailScreen inherits Scroll {
    Title {
        text: Bridge.detail-title;
        font-size: Theme.fs-xl;
    }
    Label { text: Bridge.detail-subtitle; }
    if Bridge.detail-summary != "": Body { text: Bridge.detail-summary; }
    for e in Bridge.detail-exercises: Card {
        Body {
            text: e.title;
            font-weight: 700;
        }
        if e.subtitle != "": Label { text: e.subtitle; }
        if e.badge != "": HorizontalLayout {
            alignment: start;
            Badge { text: e.badge; }
        }
        for l in e.lines: Text {
            text: l;
            color: Theme.text;
            font-size: Theme.fs-s;
            wrap: word-wrap;
        }
        if e.notes != "": Label { text: "Obs.: " + e.notes; }
    }
    if Bridge.detail-notes != "": Card {
        SectionTitle { text: "OBSERVAÇÕES DA SESSÃO"; }
        Body { text: Bridge.detail-notes; }
    }
    Label {
        text: "Registro histórico: alterações posteriores na ficha não modificam esta sessão.";
        color: Theme.faint;
    }
}

component StorageLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> strong: false;
    Text {
        text: root.label;
        color: Theme.text;
        font-size: Theme.fs-m;
        font-weight: root.strong ? 700 : 400;
        horizontal-stretch: 1;
    }
    Text {
        text: root.value;
        color: root.strong ? Theme.text : Theme.muted;
        font-size: Theme.fs-m;
        font-weight: root.strong ? 700 : 400;
    }
}

// RF-15: evolução de um exercício ao longo de um período.
export component EvolutionScreen inherits Scroll {
    Title {
        text: Bridge.evo-name;
        font-size: Theme.fs-xl;
    }
    Segmented {
        items: ["30 dias", "90 dias", "1 ano", "Tudo"];
        selected: Bridge.evo-period;
        select(i) => { Bridge.evo-set-period(i); }
    }
    Segmented {
        items: ["Carga máx.", "Volume", "1RM est.", "Reps"];
        selected: Bridge.evo-metric;
        select(i) => { Bridge.evo-set-metric(i); }
    }
    if !Bridge.evo-has-data: EmptyState {
        icon: Icons.chart;
        title: "Sem registros no período";
        text: "Não há séries deste exercício no período escolhido. Selecione um período maior.";
    }
    if Bridge.evo-has-data: Card {

        if Bridge.evo-selected-label != "": Text {
            text: Bridge.evo-selected-label;
            color: Theme.text;
            font-size: Theme.fs-s;
            font-weight: 700;
            wrap: word-wrap;
        }
        chart := Rectangle {
            height: 200px;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            Text {
                x: 6px;
                y: 4px;
                text: Bridge.evo-axis-max;
                color: Theme.faint;
                font-size: Theme.fs-xs;
            }
            Text {
                x: 6px;
                y: parent.height - self.height - 4px;
                text: "0";
                color: Theme.faint;
                font-size: Theme.fs-xs;
            }
            plot := Rectangle {
                x: 34px;
                y: 18px;
                width: parent.width - 48px;
                height: parent.height - 36px;
                init => { Bridge.evo-chart-resized(self.width / 1px, self.height / 1px); }
                changed width => { Bridge.evo-chart-resized(self.width / 1px, self.height / 1px); }
                changed height => { Bridge.evo-chart-resized(self.width / 1px, self.height / 1px); }
                Rectangle {
                    y: parent.height;
                    height: 1px;
                    background: Theme.border;
                }
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    commands: Bridge.evo-trend;
                    stroke: Theme.faint;
                    stroke-width: 1.5px;
                    fill: transparent;
                }
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    commands: Bridge.evo-path;
                    stroke: Theme.text;
                    stroke-width: 2px;
                    fill: transparent;
                }
                for p[i] in Bridge.evo-points: Rectangle {
                    x: p.x * parent.width - 22px;
                    y: p.y * parent.height - 22px;
                    width: 44px;
                    height: 44px;
                    accessible-role: button;
                    accessible-label: p.label;
                    accessible-action-default => { Bridge.evo-select-point(i); }
                    TouchArea {
                        clicked => { Bridge.evo-select-point(i); }
                    }
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: i == Bridge.evo-selected ? 14px : 9px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: i == Bridge.evo-selected ? Theme.bg : Theme.text;
                        border-width: 2.5px;
                        border-color: Theme.text;
                    }
                }
            }
        }
        Text {
            text: "Toque em um ponto para ver data e valor. Linha clara: tendência (com 3 sessões ou mais). Eixo vertical começa em 0 para não exagerar pequenas variações.";
            color: Theme.faint;
            font-size: Theme.fs-xs;
            wrap: word-wrap;
        }
        HorizontalLayout {
            Label { text: Bridge.evo-first-date; }
            Label {
                text: Bridge.evo-last-date;
                horizontal-alignment: right;
            }
        }
    }
    if Bridge.evo-summary != "": Body { text: Bridge.evo-summary; }
    if Bridge.evo-bests != "": Card {
        SectionTitle { text: "MELHORES MARCAS"; }
        Body { text: Bridge.evo-bests; }
        for r in Bridge.evo-records: Label { text: "★ " + r; }
    }
    if Bridge.evo-metric == 2: Label {
        text: "1RM estimada pela fórmula de Epley — apenas indicativa, não é recomendação de treino.";
        color: Theme.faint;
    }
    for r in Bridge.evo-rows: Rectangle {
        min-height: 44px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: r.date;
                color: Theme.muted;
                font-size: Theme.fs-s;
                vertical-alignment: center;
                min-width: 90px;
            }
            Text {
                text: r.value;
                color: Theme.text;
                font-size: Theme.fs-m;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: r.detail;
                color: Theme.muted;
                font-size: Theme.fs-s;
                vertical-alignment: center;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
        }
    }
}

component CategoryRow inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <string> description;
    callback clicked();
    min-height: 64px;
    border-radius: 12px;
    background: ta.pressed ? Theme.surface2 : Theme.surface;
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 14px;
        Icon {
            y: (parent.height - self.height) / 2;
            cmd: root.icon;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.text;
                color: Theme.text;
                font-size: Theme.fs-m;
                font-weight: 600;
            }
            Text {
                text: root.description;
                color: Theme.muted;
                font-size: Theme.fs-s;
                wrap: word-wrap;
            }
        }
        Icon {
            y: (parent.height - self.height) / 2;
            cmd: Icons.forward;
            tint: Theme.faint;
            size: 18px;
        }
    }
}

// RF-20 / 6.7: Preferências (aba principal) com categorias.
export component SettingsScreen inherits Scroll {
    if Bridge.settings-section == 0: VerticalLayout {
        spacing: 8px;
        CategoryRow {
            icon: Icons.bell;
            text: "Sons e alertas";
            description: "Fim do descanso, início de série, pré-alerta, vibração";
            clicked => { Bridge.settings-open(1); }
        }
        CategoryRow {
            icon: Icons.timer;
            text: "Cronômetro";
            description: "Duração padrão, ajuste, modo manual/automático";
            clicked => { Bridge.settings-open(2); }
        }
        CategoryRow {
            icon: Icons.dumbbell;
            text: "Treinamento";
            description: "Unidade de carga, incremento, valores padrão";
            clicked => { Bridge.settings-open(3); }
        }
        CategoryRow {
            icon: Icons.calendar;
            text: "Calendário";
            description: "Início da semana e visualização";
            clicked => { Bridge.settings-open(4); }
        }
        CategoryRow {
            icon: Icons.eye;
            text: "Interface";
            description: "Tema, texto, densidade, animações";
            clicked => { Bridge.settings-open(5); }
        }
        CategoryRow {
            icon: Icons.home;
            text: "Atalhos da Home";
            description: "Escolha até 4 atalhos de acesso rápido";
            clicked => { Bridge.settings-open(9); }
        }
        CategoryRow {
            icon: Icons.list;
            text: "Recursos opcionais";
            description: "Ligue ou desligue módulos sem perder dados";
            clicked => { Bridge.settings-open(8); }
        }
        CategoryRow {
            icon: Icons.database;
            text: "Dados e armazenamento";
            description: "Espaço usado, importar, exportar e planilhas";
            clicked => { Bridge.settings-open(6); }
        }
        CategoryRow {
            icon: Icons.copy;
            text: "Backups";
            description: "Backups no aparelho, automático semanal e restauração";
            clicked => { Bridge.settings-open(10); }
        }
        CategoryRow {
            icon: Icons.info;
            text: "Sobre";
            description: "Versão, privacidade e limitações";
            clicked => { Bridge.settings-open(7); }
        }
    }
    if Bridge.settings-section == 1: VerticalLayout {
        spacing: 2px;
        ToggleRow {
            text: "Sons";
            description: "Respeita o volume de notificações do sistema.";
            checked: Bridge.set-sound;
            toggled => { Bridge.pref-toggle("sound"); }
        }
        ValueRow {
            text: "Som do fim do descanso";
            value: Bridge.set-tone-rest;
            clicked => { Bridge.pref-choose("tone-rest"); }
        }
        ValueRow {
            text: "Som do início de série";
            value: Bridge.set-tone-start;
            description: "Usado na contagem de preparação (Cronômetro).";
            clicked => { Bridge.pref-choose("tone-start"); }
        }
        ValueRow {
            text: "Som do pré-alerta";
            value: Bridge.set-tone-pre;
            clicked => { Bridge.pref-choose("tone-pre"); }
        }
        ToggleRow {
            text: "Vibração";
            checked: Bridge.set-vibrate;
            toggled => { Bridge.pref-toggle("vibrate"); }
        }
        ToggleRow {
            text: "Vibração em ações";
            description: "Toque curto ao registrar série e ao desfazer. Não vibra em toda interação.";
            checked: Bridge.set-haptics;
            toggled => { Bridge.pref-toggle("haptics"); }
        }
        ToggleRow {
            text: "Pré-alerta";
            description: "Aviso alguns segundos antes do fim do descanso.";
            checked: Bridge.set-pre-alert;
            toggled => { Bridge.pref-toggle("pre-alert"); }
        }
        StepperRow {
            text: "Antecedência do pré-alerta";
            value: Bridge.set-pre-alert-s;
            step(d) => { Bridge.pref-step("pre-alert-s", d); }
        }
        ToggleRow {
            text: "Alerta com app em segundo plano";
            description: Bridge.notif-status;
            checked: Bridge.set-background;
            toggled => { Bridge.pref-toggle("background"); }
        }
        HorizontalLayout {
            spacing: 8px;
            Btn {
                text: "Testar";
                icon: Icons.bell;
                clicked => { Bridge.test-alert(); }
            }
            Btn {
                text: "Notificações";
                clicked => { Bridge.notif-settings(); }
            }
        }
    }
    if Bridge.settings-section == 2: VerticalLayout {
        spacing: 2px;
        StepperRow {
            text: "Duração padrão do descanso";
            description: "Usada quando o exercício não define descanso.";
            value: Bridge.set-timer-default;
            step(d) => { Bridge.pref-step("timer-default", d); }
        }
        StepperRow {
            text: "Passo do ajuste (+/−)";
            value: Bridge.set-adjust-step;
            step(d) => { Bridge.pref-step("adjust-step", d); }
        }
        ToggleRow {
            text: "Iniciar descanso automaticamente";
            description: "Modo automático: ao registrar uma série, o cronômetro começa com o descanso do exercício. Desligado = modo manual.";
            checked: Bridge.set-auto-rest;
            toggled => { Bridge.pref-toggle("auto-rest"); }
        }
        ToggleRow {
            text: "Contagem de preparação ao fim do descanso";
            description: "Ação opcional: após o descanso, conta alguns segundos e toca o alerta de início de série. A série nunca é concluída automaticamente.";
            checked: Bridge.set-rest-end-prepare;
            toggled => { Bridge.pref-toggle("rest-end-prepare"); }
        }
        StepperRow {
            text: "Duração da preparação";
            value: Bridge.set-prepare-s;
            step(d) => { Bridge.pref-step("prepare-s", d); }
        }
    }
    if Bridge.settings-section == 3: VerticalLayout {
        spacing: 2px;
        ValueRow {
            text: "Unidade de carga";
            value: Bridge.set-unit;
            clicked => { Bridge.pref-choose("unit"); }
        }
        ValueRow {
            text: "Incremento de carga (+/−)";
            value: Bridge.set-load-step;
            clicked => { Bridge.pref-choose("load-step"); }
        }
        ToggleRow {
            text: "Sugerir carga da última sessão";
            description: "Pré-preenche a carga com o último valor realizado; desligado usa a carga-alvo da ficha.";
            checked: Bridge.set-prefill-last;
            toggled => { Bridge.pref-toggle("prefill-last"); }
        }
        StepperRow {
            text: "Séries padrão (novo exercício)";
            value: Bridge.set-default-sets;
            step(d) => { Bridge.pref-step("default-sets", d); }
        }
        StepperRow {
            text: "Repetições padrão";
            value: Bridge.set-default-reps;
            step(d) => { Bridge.pref-step("default-reps", d); }
        }
        ToggleRow {
            text: "Teclado numérico do app no modo foco";
            description: "Botões grandes com vírgula, apagar e ±incremento. Desligado: usa o teclado do sistema.";
            checked: Bridge.set-app-keypad;
            toggled => { Bridge.pref-toggle("app-keypad"); }
        }
        ToggleRow {
            text: "Confirmar ao finalizar sessão";
            checked: Bridge.set-confirm-finish;
            toggled => { Bridge.pref-toggle("confirm-finish"); }
        }
    }
    if Bridge.settings-section == 4: VerticalLayout {
        spacing: 2px;
        ToggleRow {
            text: "Semana começa na segunda-feira";
            description: "Desligado: começa no domingo.";
            checked: Bridge.set-week-monday;
            toggled => { Bridge.pref-toggle("week-monday"); }
        }
        ToggleRow {
            text: "Abrir calendário na visão semanal";
            checked: Bridge.set-week-view;
            toggled => { Bridge.pref-toggle("week-view"); }
        }
        Label { text: "O calendário é interno ao app e não pede acesso à agenda do aparelho. Para levar seus treinos a outro calendário, use Dados e armazenamento › Exportar calendário (.ics)."; }
    }
    if Bridge.settings-section == 5: VerticalLayout {
        spacing: 2px;
        ValueRow {
            text: "Tema";
            value: Bridge.set-theme;
            clicked => { Bridge.pref-choose("theme"); }
        }
        ValueRow {
            text: "Tamanho do texto";
            value: Bridge.set-text-size;
            clicked => { Bridge.pref-choose("text-size"); }
        }
        ValueRow {
            text: "Densidade";
            value: Bridge.set-density;
            clicked => { Bridge.pref-choose("density"); }
        }
        ValueRow {
            text: "Animações";
            value: Bridge.set-anim;
            clicked => { Bridge.pref-choose("anim"); }
        }
        ValueRow {
            text: "Velocidade das animações";
            value: Bridge.set-anim-speed;
            clicked => { Bridge.pref-choose("anim-speed"); }
        }
        ToggleRow {
            text: "Manter tela ligada durante a sessão";
            checked: Bridge.set-keep-screen;
            toggled => { Bridge.pref-toggle("keep-screen"); }
        }
    }
    if Bridge.settings-section == 6: VerticalLayout {
        spacing: 10px;
        Card {
            SectionTitle { text: "ESPAÇO USADO NO APARELHO"; }
            StorageLine { label: "Banco de dados"; value: Bridge.storage-db; }
            StorageLine { label: "Backups locais"; value: Bridge.storage-backups; }
            StorageLine { label: "Arquivos temporários"; value: Bridge.storage-temp; }
            Rectangle { height: 1px; background: Theme.border; }
            StorageLine { label: "Total"; value: Bridge.storage-total; strong: true; }
            Label { text: Bridge.data-info; }
        }
        Btn {
            text: "Limpar arquivos temporários";
            icon: Icons.trash;
            clicked => { Bridge.storage-clear-temp(); }
        }
        SectionTitle { text: "PLANILHAS"; }
        Btn {
            text: "Importar planilha (XLSX)";
            icon: Icons.upload;
            clicked => { Bridge.data-import(); }
        }
        Btn {
            text: "Exportar planilha…";
            icon: Icons.download;
            clicked => { Bridge.data-export(); }
        }
        Btn {
            text: "Baixar modelo de importação";
            icon: Icons.download;
            clicked => { Bridge.data-template(); }
        }
        SectionTitle { text: "BACKUP"; }
        Label { text: "Backups completos (fichas, sessões, exercícios e preferências) agora ficam em Configurações › Backups, com backup automático semanal no aparelho."; }
        Btn {
            text: "Abrir backups";
            icon: Icons.copy;
            clicked => { Bridge.settings-open(10); }
        }
        SectionTitle { text: "CALENDÁRIO"; }
        Btn {
            text: "Exportar calendário (.ics)";
            icon: Icons.calendar;
            clicked => { Bridge.data-ics(); }
        }
    }
    if Bridge.settings-section == 8: VerticalLayout {
        spacing: 2px;
        Label { text: "Desligar um recurso só esconde a função: nenhum dado é apagado. Ao religar, tudo volta como estava."; }
        ToggleRow {
            text: "Recordes pessoais";
            description: "Aviso ao bater uma marca, cartão na Home e melhores marcas na Evolução";
            checked: Bridge.set-mod-records;
            toggled => { Bridge.pref-toggle("mod-records"); }
        }
        ToggleRow {
            text: "Mapa de intensidade do calendário";
            description: "Opção de colorir os dias pelo volume treinado";
            checked: Bridge.set-mod-heatmap;
            toggled => { Bridge.pref-toggle("mod-heatmap"); }
        }
        ToggleRow {
            text: "Sugestão de progressão";
            description: "Sugere aumentar a carga no editor da ficha (nunca altera sozinho)";
            checked: Bridge.set-mod-progression;
            toggled => { Bridge.pref-toggle("mod-progression"); }
        }
        ToggleRow {
            text: "Gestos";
            description: "Deslizar no modo foco (série) e no calendário (período). Os botões continuam disponíveis";
            checked: Bridge.set-mod-gestures;
            toggled => { Bridge.pref-toggle("mod-gestures"); }
        }
        ToggleRow {
            text: "Animações decorativas";
            description: "Efeitos que não informam nada (pulso do recorde, entrada de telas vazias)";
            checked: Bridge.set-mod-decorative;
            toggled => { Bridge.pref-toggle("mod-decorative"); }
        }
        ToggleRow {
            text: "Lembrete de cópia externa do backup";
            description: "Cartão na Home quando faz mais de 30 dias sem salvar um backup fora do aparelho";
            checked: Bridge.set-mod-backup-reminder;
            toggled => { Bridge.pref-toggle("mod-backup-reminder"); }
        }
    }
    if Bridge.settings-section == 9: VerticalLayout {
        spacing: 2px;
        Label { text: "Os atalhos aparecem no topo da Home. Toque em uma posição para trocar; escolher um atalho que já está em outra posição troca os dois de lugar."; }
        for slot[i] in Bridge.shortcut-slots: ValueRow {
            text: "Posição " + (i + 1);
            value: slot;
            clicked => { Bridge.shortcut-slot(i); }
        }
        Btn {
            text: "Restaurar atalhos padrão";
            icon: Icons.reset;
            clicked => { Bridge.shortcuts-reset(); }
        }
    }
    if Bridge.settings-section == 10: VerticalLayout {
        spacing: 10px;
        Card {
            SectionTitle { text: "BACKUPS NO APARELHO"; }
            Body { text: Bridge.backups-info; }
        }
        ToggleRow {
            text: "Backup automático semanal";
            description: "Ao abrir o app, se o último tiver 7 dias ou mais. Mantém os 4 mais recentes.";
            checked: Bridge.set-auto-backup;
            toggled => { Bridge.pref-toggle("auto-backup"); }
        }
        Btn {
            text: "Criar backup agora";
            icon: Icons.plus;
            kind: "primary";
            clicked => { Bridge.backup-local-create(); }
        }
        if Bridge.local-backups.length == 0: EmptyState {
            icon: Icons.copy;
            title: "Nenhum backup no aparelho";
            text: "Crie um backup agora ou aguarde o backup automático semanal.";
        }
        for bk in Bridge.local-backups: Card {
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: bk.title;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                Badge { text: bk.automatic ? "Automático" : "Manual"; }
            }
            Label { text: bk.subtitle; }
            HorizontalLayout {
                spacing: 6px;
                if bk.valid: Btn {
                    text: "Restaurar";
                    compact: true;
                    clicked => { Bridge.backup-local-restore(bk.index); }
                }
                if bk.valid: Btn {
                    text: "Salvar cópia";
                    compact: true;
                    clicked => { Bridge.backup-local-export(bk.index); }
                }
                Btn {
                    text: "Excluir";
                    compact: true;
                    kind: "danger";
                    clicked => { Bridge.backup-local-delete(bk.index); }
                }
            }
        }
        SectionTitle { text: "BACKUP EM ARQUIVO"; }
        Label { text: "Backups no aparelho não protegem contra perda, troca ou desinstalação do app. Salve uma cópia fora dele (com senha opcional) ou restaure um arquivo salvo antes."; }
        Btn {
            text: "Salvar backup em arquivo…";
            icon: Icons.download;
            clicked => { Bridge.data-backup(); }
        }
        Btn {
            text: "Restaurar de um arquivo…";
            icon: Icons.upload;
            kind: "danger";
            clicked => { Bridge.data-restore(); }
        }
    }
    if Bridge.settings-section == 7: VerticalLayout {
        spacing: 10px;
        BrandLogoVertical { }
        Text {
            text: "Versão " + Bridge.app-version;
            color: Theme.muted;
            font-size: Theme.fs-s;
            horizontal-alignment: center;
        }
        Body { text: Bridge.about-text; }
        Btn {
            text: "Diagnóstico técnico";
            icon: Icons.info;
            clicked => { Bridge.show-diagnostics(); }
        }
    }
}

// RF-16 / RN-09 / RN-10: prévia e mapeamento antes de gravar.
export component ImportScreen inherits Scroll {
    Label { text: "Arquivo: " + Bridge.imp-file; }
    if Bridge.imp-multi-sheet: ValueRow {
        text: "Aba";
        value: Bridge.imp-sheet;
        clicked => { Bridge.imp-choose-sheet(); }
    }
    if Bridge.imp-all-sheets: Label { text: "Todas as abas: as colunas de cada aba são reconhecidas automaticamente. Para ajustar o mapeamento manualmente, escolha uma aba por vez."; }
    if !Bridge.imp-all-sheets: SectionTitle { text: "MAPEAMENTO DE COLUNAS"; }
    if !Bridge.imp-all-sheets: Label { text: "Toque em uma coluna para mudar o campo correspondente. \"Exercício\" é obrigatório."; }
    for c in Bridge.imp-columns: ValueRow {
        text: c.header;
        description: c.sample;
        value: c.field;
        clicked => { Bridge.imp-map(c.index); }
    }
    SectionTitle { text: "PRÉVIA"; }
    Body { text: Bridge.imp-summary; }
    for p in Bridge.imp-plans: Card {
        HorizontalLayout {
            spacing: 8px;
            Body {
                text: p.name;
                font-weight: 700;
            }
            if p.conflict: Badge { text: "Já existe"; }
        }
        Label { text: p.detail; }
    }
    if Bridge.imp-has-conflicts: ToggleRow {
        text: "Substituir fichas existentes com o mesmo nome";
        description: Bridge.imp-replace
            ? "A ficha existente será apagada e recriada. Sessões do histórico são mantidas."
            : "Desligado: a ficha importada é criada com o sufixo \"(importada)\"; nada é sobrescrito.";
        checked: Bridge.imp-replace;
        toggled => { Bridge.imp-set-replace(!Bridge.imp-replace); }
    }
    if Bridge.imp-errors.length > 0: Card {
        SectionTitle { text: "ERROS (" + Bridge.imp-errors.length + ")"; }
        for e in Bridge.imp-errors: Body { text: "✕ " + e; }
    }
    if Bridge.imp-warnings.length > 0: Card {
        SectionTitle { text: "AVISOS (" + Bridge.imp-warnings.length + ")"; }
        for w in Bridge.imp-warnings: Label {
            text: "! " + w;
            color: Theme.text;
        }
    }
    if Bridge.imp-warnings.length > 0: ToggleRow {
        text: "Conferi os avisos acima";
        description: "Necessário para confirmar a importação.";
        checked: Bridge.imp-reviewed;
        toggled => { Bridge.imp-set-reviewed(!Bridge.imp-reviewed); }
    }
    HorizontalLayout {
        spacing: 8px;
        Btn {
            text: "Cancelar";
            clicked => { Bridge.imp-cancel(); }
        }
        Btn {
            text: "Importar";
            icon: Icons.check;
            kind: "primary";
            enabled: Bridge.imp-can-import && (Bridge.imp-warnings.length == 0 || Bridge.imp-reviewed);
            clicked => { Bridge.imp-confirm(); }
        }
    }
}

import { Theme, Icons } from "../theme.slint";
import { Bridge } from "../bridge.slint";
import { ToggleRow } from "../components/widgets.slint";
import { Btn, IconBtn, Card, Label, Title, SectionTitle, Body, Scroll, Segmented, Badge, Icon } from "../components/widgets.slint";
import { EmptyState } from "../components/empty_state.slint";
import { StarBtn } from "../components/widgets.slint";

// Atalho personalizável da Home (7.4): o código vem do Rust; aqui só se escolhe o ícone.
component ShortcutTile inherits Rectangle {
    in property <string> code;
    in property <string> label;
    in property <string> icon-name;
    callback clicked();
    min-height: 72px;
    border-radius: 14px;
    background: ta.pressed ? Theme.surface2 : Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea { clicked => { root.clicked(); } }
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Icon {
                size: 22px;
                cmd: root.icon-name == "play" ? Icons.play
                    : root.icon-name == "timer" ? Icons.timer
                    : root.icon-name == "dumbbell" ? Icons.dumbbell
                    : root.icon-name == "search" ? Icons.search
                    : root.icon-name == "chart" ? Icons.chart
                    : root.icon-name == "calendar" ? Icons.calendar
                    : root.icon-name == "history" ? Icons.history
                    : root.icon-name == "plus" ? Icons.plus
                    : root.icon-name == "template" ? Icons.template
                    : root.icon-name == "database" ? Icons.database
                    : root.icon-name == "tools" ? Icons.tools
                    : Icons.info;
            }
        }
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// RF-19 / 6.2: cartões informativos clicáveis.
export component HomeScreen inherits Scroll {
    Text {
        text: Bridge.home-date;
        color: Theme.muted;
        font-size: Theme.fs-s;
    }
    if Bridge.home-shortcuts.length > 0: HorizontalLayout {
        spacing: 8px;
        for sc in Bridge.home-shortcuts: ShortcutTile {
            horizontal-stretch: 1;
            code: sc.code;
            label: sc.label;
            icon-name: sc.icon;
            clicked => { Bridge.home-shortcut(sc.code); }
        }
    }
    for c[i] in Bridge.home-cards: Card {
        // Entrada dos cartões da Home (evolução 3.3) — decorativa, em cascata curta.
        property <bool> shown: false;
        Timer {
            interval: (30ms + i * 45ms) * Theme.anim-scale;
            running: !parent.shown;
            triggered => { parent.shown = true; }
        }
        opacity: self.shown || !Theme.decorative ? 1 : 0;
        animate opacity { duration: Theme.decorative ? 260ms : 0ms; easing: ease-out; }
        clickable: true;
        accessible-role: button;
        accessible-label: c.title + ". " + c.line1 + ". " + c.line2;
        clicked => { Bridge.home-card-clicked(c.kind, c.ref-id); }
        SectionTitle { text: c.title; }
        Text {
            text: c.line1;
            color: Theme.text;
            font-size: Theme.fs-l;
            font-weight: 700;
            wrap: word-wrap;
        }
        if c.line2 != "": Label { text: c.line2; }
        if c.action != "": HorizontalLayout {
            alignment: end;
            Text {
                text: c.action + "  ›";
                color: Theme.text;
                font-size: Theme.fs-s;
                font-weight: 600;
            }
        }
    }
}

export component PlansScreen inherits Scroll {
    HorizontalLayout {
        spacing: 8px;
        Btn {
            text: @tr("Nova ficha");
            icon: Icons.plus;
            kind: "primary";
            clicked => { Bridge.new-plan(); }
        }
        Btn {
            text: @tr("Modelos");
            icon: Icons.template;
            clicked => { Bridge.open-templates(); }
        }
    }
    Btn {
        text: @tr("Biblioteca de exercícios");
        icon: Icons.list;
        clicked => { Bridge.open-library(); }
    }
    if Bridge.plans.length == 0: EmptyState {
        icon: Icons.dumbbell;
        title: @tr("Crie sua primeira ficha");
        text: @tr("Você ainda não tem fichas de treino. Monte uma do zero, comece por um modelo pronto ou importe uma planilha em Configurações › Dados.");
        action: @tr("Criar ficha");
        action-clicked => { Bridge.new-plan(); }
    }
    for p in Bridge.plans: Card {
        clickable: true;
        accessible-role: button;
        accessible-label: @tr("Ficha ") + p.name;
        clicked => { Bridge.open-plan(p.id); }
        HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                spacing: 4px;
                alignment: center;
                Title { text: p.name; }
                Label { text: p.subtitle; }
                if !p.active: HorizontalLayout {
                    alignment: start;
                    Badge { text: @tr("Inativa"); }
                }
            }
            StarBtn {
                on: p.favorite;
                name: p.name;
                clicked => { Bridge.plan-favorite(p.id); }
            }
            IconBtn {
                icon: Icons.copy;
                label: @tr("Duplicar ficha ") + p.name;
                clicked => { Bridge.duplicate-plan(p.id); }
            }
            IconBtn {
                icon: Icons.trash;
                label: @tr("Excluir ficha ") + p.name;
                clicked => { Bridge.delete-plan(p.id); }
            }
        }
    }
}

// RF-13 / 6.5: calendário interno focado, sem excesso de estatísticas.
export component CalendarScreen inherits Scroll {
    HorizontalLayout {
        IconBtn {
            icon: Icons.back;
            label: @tr("Período anterior");
            clicked => { Bridge.cal-prev(); }
        }
        Text {
            text: Bridge.cal-title;
            color: Theme.text;
            font-size: Theme.fs-l;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        IconBtn {
            icon: Icons.forward;
            label: @tr("Próximo período");
            clicked => { Bridge.cal-next(); }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Segmented {
            horizontal-stretch: 1;
            items: [@tr("Mês"), @tr("Semana")];
            selected: Bridge.cal-week-view ? 1 : 0;
            select(i) => { Bridge.cal-set-week-view(i == 1); }
        }
        Btn {
            text: @tr("Hoje");
            compact: true;
            horizontal-stretch: 0;
            clicked => { Bridge.cal-today(); }
        }
    }
    if Bridge.cal-heatmap-available: ToggleRow {
        text: @tr("Mapa de intensidade");
        description: @tr("Dias mais escuros tiveram maior volume (carga × repetições). Volume não indica qualidade do treino.");
        checked: Bridge.cal-heatmap;
        toggled => { Bridge.cal-toggle-heatmap(); }
    }
    HorizontalLayout {
        for w in Bridge.cal-weekday-labels: Text {
            text: w;
            color: Theme.muted;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            horizontal-stretch: 1;
        }
    }
    // Gesto opcional: deslizar troca o período (os botões ‹ › continuam disponíveis).
    SwipeGestureHandler {
        enabled: Bridge.gestures-enabled;
        handle-swipe-left: true;
        handle-swipe-right: true;
        height: grid.height;
        swiped => {
            if (self.current-position.x - self.pressed-position.x < -60px) {
                Bridge.gesture("calendar", "swipe-left");
            } else if (self.current-position.x - self.pressed-position.x > 60px) {
                Bridge.gesture("calendar", "swipe-right");
            }
        }
        grid := Rectangle {
            property <length> cell-h: 50px;
            height: Math.ceil(Bridge.cal-cells.length / 7) * self.cell-h;
            for c[i] in Bridge.cal-cells: Rectangle {
                x: Math.mod(i, 7) * (parent.width / 7);
                y: Math.floor(i / 7) * grid.cell-h;
                width: parent.width / 7;
                height: grid.cell-h;
                accessible-role: button;
                accessible-label: c.day + (c.planned ? @tr(", treino planejado") : "") + (c.done ? @tr(", treino realizado") : "") + (Bridge.cal-heatmap && c.heat-text != "" ? ", " + c.heat-text : "") + (c.today ? @tr(", hoje") : "");
                accessible-action-default => { Bridge.cal-select(c.key); }
                TouchArea {
                    clicked => { Bridge.cal-select(c.key); }
                }
                Rectangle {
                    width: 40px;
                    height: 40px;
                    x: (parent.width - self.width) / 2;
                    y: 2px;
                    border-radius: Bridge.cal-heatmap && c.done && !c.selected ? 8px : 20px;
                    background: c.selected ? Theme.accent : (Bridge.cal-heatmap && c.done ? Theme.text.with-alpha(0.12 + 0.6 * c.heat) : transparent);
                    border-width: c.today && !c.selected ? 2px : 0px;
                    border-color: Theme.text;
                    Text {
                        y: 6px;
                        width: parent.width;
                        text: c.day;
                        horizontal-alignment: center;
                        font-size: Theme.fs-s;
                        font-weight: c.today ? 700 : 400;
                        color: c.selected ? Theme.on-accent : (Bridge.cal-heatmap && c.done && c.heat > 0.55 ? Theme.bg : (c.in-month ? Theme.text : Theme.faint));
                    }
                    // marcadores: cheio = realizado, vazado = planejado (forma, não só cor)
                    HorizontalLayout {
                        y: 27px;
                        height: 7px;
                        alignment: center;
                        spacing: 3px;
                        if c.done: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: c.selected ? Theme.on-accent : Theme.text;
                        }
                        if c.planned: Rectangle {
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            border-width: 1.5px;
                            border-color: c.selected ? Theme.on-accent : Theme.muted;
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 16px;
        alignment: center;
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: 5px;
                border-radius: 4px;
                background: Theme.text;
            }
            Label { text: @tr("realizado"); }
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle {
                width: 8px;
                height: 8px;
                y: 5px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: Theme.muted;
            }
            Label { text: @tr("planejado"); }
        }
    }
    Rectangle { height: 4px; }
    Title { text: Bridge.cal-selected-title; }
    if Bridge.cal-entries.length == 0: Label { text: @tr("Nada planejado ou realizado nesta data."); }
    for e[i] in Bridge.cal-entries: Card {
        clickable: true;
        clicked => { Bridge.cal-entry(i); }
        HorizontalLayout {
            alignment: start;
            Badge { text: e.kind == "done" ? @tr("Realizado") : @tr("Planejado"); }
        }
        Body {
            text: e.title;
            font-weight: 600;
        }
        if e.subtitle != "": Label { text: e.subtitle; }
        HorizontalLayout {
            spacing: 8px;
            if e.can-start: Btn {
                text: @tr("Iniciar");
                icon: Icons.play;
                kind: "primary";
                clicked => { Bridge.cal-entry(i); }
            }
            Btn {
                text: @tr("Agenda");
                icon: Icons.calendar;
                accessible-label: @tr("Adicionar à agenda do aparelho");
                clicked => { Bridge.cal-add-to-agenda(i); }
            }
        }
    }
}

// RF-14 / RF-15 / 6.6: visão geral; detalhe e evolução abrem em telas próprias.
component BarLine inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> frac;
    spacing: 3px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.fs-s;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value;
            color: Theme.muted;
            font-size: Theme.fs-s;
        }
    }
    Rectangle {
        height: 8px;
        border-radius: 4px;
        background: Theme.surface2;
        Rectangle {
            x: 0;
            width: parent.width * root.frac;
            animate width { duration: Theme.anim-page; easing: ease-out; }
            border-radius: 4px;
            background: Theme.text;
        }
    }
}

export component HistoryScreen inherits Scroll {
    Segmented {
        items: [@tr("Sessões"), @tr("Evolução"), @tr("Mensal"), @tr("Diário")];
        selected: Bridge.hist-tab;
        select(i) => { Bridge.hist-set-tab(i); }
    }
    if Bridge.hist-tab == 0 && Bridge.hist-summary != "": Label { text: Bridge.hist-summary; }
    if Bridge.hist-tab == 0 && Bridge.hist-rows.length == 0: EmptyState {
        icon: Icons.history;
        title: @tr("Seu histórico aparecerá após o primeiro treino");
        text: @tr("Nenhuma sessão foi concluída ainda. Inicie um treino e finalize-o para vê-lo aqui.");
        action: @tr("Ver fichas");
        action-clicked => { Bridge.navigate(1); }
    }
    if Bridge.hist-tab == 0: VerticalLayout {
        spacing: Theme.gap;
        for r in Bridge.hist-rows: Card {
            clickable: true;
            accessible-role: button;
            accessible-label: r.date + " " + r.title;
            clicked => { Bridge.hist-open(r.id); }
            Label { text: r.date; }
            Body {
                text: r.title;
                font-weight: 600;
            }
            Label { text: r.subtitle; }
        }
        if Bridge.hist-has-more: Btn {
            text: @tr("Carregar mais");
            clicked => { Bridge.hist-more(); }
        }
    }
    if Bridge.hist-tab == 1 && Bridge.evo-exercises.length == 0: EmptyState {
        icon: Icons.chart;
        title: @tr("Sem dados de evolução");
        text: @tr("A evolução aparece depois que você registrar séries em sessões concluídas.");
    }
    if Bridge.hist-tab == 1: VerticalLayout {
        spacing: Theme.gap;
        for x in Bridge.evo-exercises: Card {
            clickable: true;
            accessible-role: button;
            accessible-label: @tr("Evolução de ") + x.name;
            clicked => { Bridge.evo-open(x.key); }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    spacing: 2px;
                    Body {
                        text: x.name;
                        font-weight: 600;
                    }
                    Label { text: x.detail; }
                }
                Icon {
                    y: (parent.height - self.height) / 2;
                    cmd: Icons.chart;
                    tint: Theme.muted;
                }
            }
        }
    }
    // Relatório mensal (8.8)
    if Bridge.hist-tab == 2: VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            IconBtn {
                icon: Icons.back;
                label: @tr("Mês anterior");
                clicked => { Bridge.rep-shift(-1); }
            }
            Text {
                text: Bridge.rep-title;
                color: Theme.text;
                font-size: Theme.fs-l;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconBtn {
                icon: Icons.forward;
                label: @tr("Próximo mês");
                clicked => { Bridge.rep-shift(1); }
            }
        }
        if Bridge.rep-empty: EmptyState {
            icon: Icons.chart;
            title: @tr("Nenhum treino neste mês");
            text: @tr("O relatório aparece quando houver sessões concluídas no mês escolhido.");
        }
        if !Bridge.rep-empty: Card {
            for r in Bridge.rep-rows: HorizontalLayout {
                Text {
                    text: r.label;
                    color: Theme.muted;
                    font-size: Theme.fs-m;
                    horizontal-stretch: 1;
                }
                Text {
                    text: r.a;
                    color: Theme.text;
                    font-size: Theme.fs-m;
                    font-weight: 700;
                }
            }
        }
        if !Bridge.rep-empty: Card {
            SectionTitle { text: @tr("SESSÕES POR SEMANA"); }
            for w in Bridge.rep-weeks: BarLine { label: w.label; value: w.value; frac: w.frac; }
        }
        if !Bridge.rep-empty && Bridge.rep-muscles.length > 0: Card {
            SectionTitle { text: @tr("SÉRIES POR GRUPO MUSCULAR"); }
            for m in Bridge.rep-muscles: BarLine { label: m.label; value: m.value; frac: m.frac; }
        }
        if !Bridge.rep-empty && Bridge.rep-records.length > 0: Card {
            SectionTitle { text: @tr("RECORDES DO MÊS"); }
            for r in Bridge.rep-records: Body { text: "★ " + r; }
        }
        if !Bridge.rep-empty: Btn {
            text: @tr("Compartilhar resumo");
            icon: Icons.upload;
            clicked => { Bridge.rep-share(); }
        }
    }
    // Diário de treinamento (8.9)
    if Bridge.hist-tab == 3 && Bridge.diary.length == 0: EmptyState {
        icon: Icons.note;
        title: @tr("Seu diário está vazio");
        text: @tr("Durante a sessão, toque em \"Como foi o treino?\" e em \"Observações da sessão\". Ao finalizar, o registro aparece aqui.");
    }
    if Bridge.hist-tab == 3: VerticalLayout {
        spacing: Theme.gap;
        for d in Bridge.diary: Card {
            clickable: true;
            accessible-role: button;
            accessible-label: d.date + " " + d.title;
            clicked => { Bridge.hist-open(d.id); }
            HorizontalLayout {
                Label { text: d.date; horizontal-stretch: 1; }
                if d.feeling != "": Badge { text: d.feeling; }
            }
            Body {
                text: d.title;
                font-weight: 600;
            }
            if d.text != "": Body { text: d.text; }
        }
    }
}
